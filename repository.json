    "Text": [
      {
        "$type": "TextSave",
        "TextRoot": {
          "Id": 1,
          "Name": "OOP_Architecture_Guide",
          "Rank": 0,
          "Children": [
            {
              "$type": "Heading",
              "Id": 2,
              "Name": "1. Architectural Layers",
              "Rank": 1,
              "Children": [
                {
                  "$type": "Paragraph",
                  "Id": 3,
                  "Content": "Modern software architecture strictly separates domain logic from infrastructural concerns.",
                  "Name": "Paragraph #3"
                },
                {
                  "$type": "Link",
                  "Id": 4,
                  "Text": "Clean Architecture Reference",
                  "Url": "https://martinfowler.com/articles/dipInTheWild.html",
                  "Name": "Clean Architecture Reference"
                },
                {
                  "$type": "Heading",
                  "Id": 5,
                  "Name": "1.1 Data Transfer Objects",
                  "Rank": 2,
                  "Children": [
                    {
                      "$type": "Paragraph",
                      "Id": 6,
                      "Content": "DTOs encapsulate formatting and transport concerns, preventing presentation leaks into Core.",
                      "Name": "Paragraph #6"
                    },
                    {
                      "$type": "Image",
                      "Id": 7,
                      "AltText": "DTO Architecture Diagram",
                      "SourceUrl": "https://example.org/dto-diagram.png",
                      "Name": "DTO Architecture Diagram"
                    },
                    {
                      "$type": "Paragraph",
                      "Id": 10,
                      "Content": "DTO serialization ensures lightweight data delivery between system boundaries.",
                      "Name": "Paragraph #10"
                    },
                    {
                      "$type": "Link",
                      "Id": 11,
                      "Text": "DTO Pattern Documentation",
                      "Url": "https://learn.microsoft.com/dotnet/architecture/",
                      "Name": "DTO Pattern Documentation"
                    }
                  ],
                  "ParentId": 2
                },
                {
                  "$type": "Heading",
                  "Id": 12,
                  "Name": "1.2 Infrastructure Inversion",
                  "Rank": 2,
                  "Children": [
                    {
                      "$type": "Paragraph",
                      "Id": 13,
                      "Content": "Infrastructure depends on core domain contracts through interfaces, guaranteeing testability.",
                      "Name": "Paragraph #13"
                    }
                  ],
                  "ParentId": 2
                }
              ],
              "ParentId": 1
            },
            {
              "$type": "Heading",
              "Id": 8,
              "Name": "2. Persistence with Repository",
              "Rank": 1,
              "Children": [
                {
                  "$type": "Paragraph",
                  "Id": 9,
                  "Content": "The repository pattern abstracts JSON serialization away from business operations.",
                  "Name": "Paragraph #9"
                }
              ],
              "ParentId": 1
            }
          ],
          "ParentId": null
        },
